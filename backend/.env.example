# Copy to backend/.env and fill in what you need. Every setting is optional except
# ANTHROPIC_API_KEY, which only the AI features require; market-data features work without it.
# backend/.env is git-ignored — never commit real keys.

# AI features (AI Chat, Trade Ideas, News Sentiment, Earnings Summaries, Financial Advisor,
# NLP Screener, Stock Analyzer, Portfolio Review, Tax Advisor, Morning Briefing, digest summary)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: AI Chat uses Gemini (gemini-2.0-flash) instead of Claude when this is set
# GEMINI_API_KEY=

# Optional: delivery channel for the scheduled daily/weekly digests
# (AI Tools -> Digests walks through creating the Telegram bot in about two minutes)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# Set to 0 to turn the background digest scheduler off
# DIGEST_SCHEDULER=1
